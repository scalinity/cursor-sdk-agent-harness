# Cursor SDK Agent Harness — non-secret environment variables.
# Copy to .env (gitignored) for local development.

# Fastify bind host. Default 127.0.0.1 (loopback-only). Binding to a non-loopback
# address requires ALLOW_REMOTE_BIND=true and is not recommended.
HOST=127.0.0.1

# Fastify HTTP/WebSocket port.
PORT=4783

# Allowed dev UI origin (for CORS + WebSocket origin check).
WEB_ORIGIN=http://127.0.0.1:5173

# SQLite database path. Defaults to macOS application-support path.
# DB_PATH=~/Library/Application Support/cursor-sdk-agent-harness/harness.sqlite

# Server log level. One of: debug | info | warn | error.
LOG_LEVEL=info

# macOS Keychain service name. Only override for multi-install isolation.
KEYCHAIN_SERVICE=cursor-sdk-agent-harness

# One-shot bootstrap import of Cursor API key into Keychain. NEVER commit a
# real key. After first successful boot the key lives in the Keychain only and
# this variable should be removed from .env.
# CURSOR_API_KEY=

# Set to true to allow binding non-loopback hosts. Required for HOST=0.0.0.0.
# Leave unset for normal local-first operation.
ALLOW_REMOTE_BIND=false
