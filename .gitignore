# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
coverage/
*.tsbuildinfo
# Desktop build resources (icons, entitlements) are app config, not build output.
!apps/desktop/build
!apps/desktop/build/**
# electron-builder output
apps/desktop/dist-electron/

# Secrets and environment
.env
.env.*
!.env.example
*.local

# Local databases and runtime state
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/

# OS
.DS_Store
Thumbs.db

# Editor / AI tooling
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
.cursor/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test artifacts
.playwright-mcp/
screenshots/
playwright-report/
test-results/
phase*-*.png

# Temporary
.tmp/
*.tmp

# VAD (Silero) runtime assets — copied from node_modules by scripts/copy-vad-assets.mjs
apps/web/public/vad/
